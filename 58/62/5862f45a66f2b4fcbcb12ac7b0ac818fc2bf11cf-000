<!doctype html>
<!-- HDA rank-row : definition unique, 20 instances. Aucune valeur en dur ici. -->
<html><head><meta charset="utf-8">
<style>
  @font-face { font-family:'Display'; src:url('file:///Users/zenray/Library/Fonts/AnthropicSans-Black.ttf'); }
  @font-face { font-family:'Strong';  src:url('file:///Users/zenray/Library/Fonts/AnthropicSans-Bold.ttf');  }

  html, body { margin:0; padding:0; background:transparent; }

  .row {
    width:430px; height:41px;
    display:flex; align-items:center; gap:12px;
  }

  .rank {
    width:46px; flex:0 0 46px;
    font-family:'Display'; font-size:31px; line-height:1;
    color:#EDE7DE; text-align:left; letter-spacing:-0.02em;
  }

  .bar {
    width:372px; flex:0 0 372px; height:41px;
    border-radius:4px;
    background:linear-gradient(90deg, #0B4A93, #2F8CD6);
    display:flex; align-items:center;
    padding-left:7px; box-sizing:border-box;
    overflow:hidden;
  }

  .chip {
    width:40px; height:27px; flex:0 0 40px;
    border-radius:3px; background:#FFFFFF;
    box-shadow:inset 0 0 0 1px #D8D2C8;
    padding:2px; box-sizing:border-box;
    display:flex; align-items:center; justify-content:center; overflow:hidden;
  }
  .flag {
    font-family:'Apple Color Emoji';
    font-size:39px; line-height:1;
    transform:scale(1.0);
  }

  .name {
    margin-left:13px; flex:1 1 auto;
    font-family:'Strong'; font-size:21px; line-height:1;
    color:#FFFFFF; letter-spacing:-0.005em; white-space:nowrap;
  }

  .score {
    width:79px; flex:0 0 79px; height:41px;
    background:linear-gradient(90deg, #FAB552, #ED882A);
    display:flex; align-items:center;
    padding-left:12px; box-sizing:border-box;
    font-family:'Strong'; font-size:22px; line-height:1;
    color:#FFFFFF;
  }
</style></head>
<body>
  <div class="row">
    <div class="rank">17</div>
    <div class="bar">
      <div class="chip"><span class="flag">🇱🇰</span></div>
      <div class="name">Sri Lanka</div>
      <div class="score">0.2</div>
    </div>
  </div>
</body></html>
