<!doctype html>
<html><head><meta charset="utf-8">
<style>
  @font-face {
    font-family: 'Test';
    src: url('file:///Users/zenray/Library/Fonts/Generic-G20-FR-Classic-DEMO.otf') format('opentype');
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { background: transparent; }
  .wrap { width: 1800px; height: 760px; display:flex; align-items:center; justify-content:center; }
  .cloudy {
    color: #ffffff;
    font-family: 'Test', sans-serif;
    font-size: 480px;
    letter-spacing: -0.015em;
    line-height: 0.9;
    text-transform: uppercase;
    filter: url(#cloud) drop-shadow(0 0 34px rgba(255,255,255,.34)) drop-shadow(0 0 90px rgba(255,255,255,.20));
  }
</style></head>
<body>
  <svg width="0" height="0" style="position:absolute">
    <filter id="cloud" x="-40%" y="-40%" width="180%" height="180%">
      <feTurbulence type="fractalNoise" baseFrequency="0.013" numOctaves="5" seed="11" result="noise"/>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="7"
                         xChannelSelector="R" yChannelSelector="G" result="rough"/>
      <feGaussianBlur in="rough" stdDeviation="1.6"/>
    </filter>
  </svg>
  <div class="wrap"><div class="cloudy">FUJI</div></div>
</body></html>
